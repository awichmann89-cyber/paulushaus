# Neon oder Vercel Postgres – Connection String mit ?sslmode=require
DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Zufallswert, z. B. mit: openssl rand -base64 32
AUTH_SECRET="bitte-ersetzen"

# Öffentliche Basis-URL – wird für Einladungslinks in E-Mails gebraucht
NEXT_PUBLIC_APP_URL="https://raumplaner.example.vercel.app"

# Resend – für Einladungs- und Entscheidungs-Mails
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM="Paulushaus Raumplaner <raumplaner@deine-domain.de>"

# Optional: ungepoolte Verbindung nur für Migrationen (bei Neon empfohlen)
# DIRECT_DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Optional: Migration in dieser Umgebung überspringen (z. B. Preview-Deployments)
# SKIP_DB_MIGRATE="1"

# Erster Admin – wird beim ersten Deploy angelegt, wenn noch kein Admin existiert.
# Danach können die drei Variablen wieder entfernt werden.
SEED_ADMIN_EMAIL="alex.wichmann@secunet.com"
SEED_ADMIN_NAME="Alex Wichmann"
SEED_ADMIN_PASSWORD="bitte-sicheres-passwort-setzen"
